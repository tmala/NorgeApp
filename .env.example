# Google Sheets ID for NorgeApp geodata
# La stå tom for å kjøre i demo-modus med mockdata
VITE_SPREADSHEET_ID=

# Deploy-konfigurasjon (brukes av deploy.sh / npm run deploy)
# Format: brukernavn@server.no eller bare server.no
SSH_DEPLOY_TARGET=
# Absolutt bane på serveren (minst 3 nivåer dypt, under /var/www/, /home/ eller /srv/)
# Eksempel: /home/mala/www/norgeapp
SSH_DEPLOY_PATH=